{
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/run-jobs-agent",
      "dest": "run.py"
    },
    {
      "src": "/(.*)",
      "dest": "run.py"
    }
  ],
  "crons": [
    {
      "path": "/run-jobs-agent",
      "schedule": "0 */12 * * *"
    }
  ]
}
