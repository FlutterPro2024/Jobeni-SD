{
  "version": 2,
  "builds": [
    {
      "src": "run.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "runtime": "python3.12"
      }
    }
  ],
  "routes": [
    { 
      "src": "/telegram/webhook", 
      "dest": "run.py" 
    },
    { 
      "src": "/webhook", 
      "dest": "run.py" 
    },
    { 
      "src": "/agent/run-jobs-agent", 
      "dest": "run.py" 
    },
    { 
      "src": "/agent/run-discovery", 
      "dest": "run.py" 
    },
    { 
      "src": "/agent/weekly-summary", 
      "dest": "run.py" 
    },
    { 
      "src": "/(.*)", 
      "dest": "run.py" 
    }
  ],
  "crons": [
    {
      "path": "/agent/run-jobs-agent",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/agent/run-discovery",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/agent/weekly-summary",
      "schedule": "0 10 * * 0"
    }
  ]
}
