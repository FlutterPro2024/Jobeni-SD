# الحماية القصوى: منع ملفات البيئة والباسوردات
.env
instance/
.cache
config.pyc

# ملفات قاعدة البيانات المحلية (إحنا انتقلنا لـ Postgres خلاص)
*.db
jobeni_local.db

# بيئة العمل والمكتبات (Vercel حيبنيها بنفسه)
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd

# --- [ تعديل الصور والملفات المرفوعة ] ---
# منع رفع ملفات المستخدمين الخاصة (الصور والـ CVs) لضمان الخصوصية
app/static/uploads/cvs/*
app/static/uploads/posts/*

# استثناء ملفات النظام الأساسية عشان تظهر في Vercel وما تدي 404
!app/static/uploads/default_avatar.png
!app/static/uploads/default_job_icon.png
!app/static/uploads/cvs/.gitkeep
!app/static/uploads/.gitkeep

# ملفات النظام واللوغز
*.log
.DS_Store
.vscode/
.idea/
